---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Danendra Lohanata — Data, AI, and Analytics',
  description = 'Personal website of Danendra Lohanata. Data and AI Specialist at Oyika, NTU Mathematics graduate (CGPA 4.88/5.00), and Microsoft Excel World Championship competitor based in Singapore.',
} = Astro.props;

const siteUrl = 'https://danendral.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL('/profile_image.png', siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Danendra Lohanata" />
    <meta name="keywords" content="Danendra Lohanata, Danendra, Lohanata, Data Analyst, AI Engineer, Oyika, NTU, Excel esports, Singapore, Data Science, Machine Learning" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" as="image" href="/profile_image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Danendra Lohanata" />
    <meta property="og:site_name" content="Danendra Lohanata" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="9631d513-4a40-465b-a909-8b5ff7fa4ce6"></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Danendra Lohanata",
      "givenName": "Danendra",
      "familyName": "Lohanata",
      "jobTitle": "Data and AI Specialist",
      "description": "Data and AI Specialist at Oyika, NTU Mathematics graduate, and Microsoft Excel World Championship competitor based in Singapore.",
      "image": ogImageUrl,
      "url": siteUrl,
      "email": "mailto:danendra.lohanata@gmail.com",
      "worksFor": {
        "@type": "Organization",
        "name": "Oyika",
        "url": "https://oyika.com"
      },
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Nanyang Technological University",
          "url": "https://www.ntu.edu.sg"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "National University of Singapore",
          "url": "https://www.nus.edu.sg"
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Singapore",
        "addressCountry": "SG"
      },
      "knowsAbout": ["Data Analytics", "Artificial Intelligence", "Machine Learning", "Microsoft Excel", "SQL", "Python", "Databricks"],
      "sameAs": [
        "https://linkedin.com/in/danendralohanata",
        "https://github.com/danendralohanata",
        "https://github.com/danendral"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Danendra Lohanata",
      "url": siteUrl,
      "author": { "@type": "Person", "name": "Danendra Lohanata" }
    })} />
  </head>
  <body class="text-text-primary min-h-screen" style="background: linear-gradient(180deg, #0A0A0A 0%, #0D1B2A 15%, #0F1E30 30%, #0D1B2A 50%, #0F1E30 70%, #0D1B2A 85%, #0A0A0A 100%); background-attachment: fixed;">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ChatWidget client:load />

    <!-- Back to Top Button -->
    <button
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-8 right-8 z-50 p-3 rounded-full bg-bg-elevated border border-border text-accent opacity-0 translate-y-10 transition-all duration-300 hover:scale-110 hover:border-accent cursor-pointer shadow-lg invisible"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <script>
      const backToTop = document.getElementById('back-to-top');
      
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          backToTop?.classList.remove('opacity-0', 'translate-y-10', 'invisible');
          backToTop?.classList.add('opacity-100', 'translate-y-0', 'visible');
        } else {
          backToTop?.classList.add('opacity-0', 'translate-y-10', 'invisible');
          backToTop?.classList.remove('opacity-100', 'translate-y-0', 'visible');
        }
      });

      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
